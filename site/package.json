{
  "name": "ayaml-site",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Documentation site and benchmarks for ayaml",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "check:links": "node scripts/check-links.mjs",
    "test:scripts": "node --test scripts/test-scripts.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "astro": "7.4.13"
  }
}
