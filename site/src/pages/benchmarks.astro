---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import DivergingRatioChart from '../components/charts/DivergingRatioChart.astro';
import DualMetricBarChart from '../components/charts/DualMetricBarChart.astro';
import GroupedBarChart from '../components/charts/GroupedBarChart.astro';
import SpeedupBulletChart from '../components/charts/SpeedupBulletChart.astro';
import ScalingPlot from '../components/charts/ScalingPlot.astro';
import ScenarioDotStrip from '../components/charts/ScenarioDotStrip.astro';
import { BASE, SITE_URL } from '../lib/site';
import {
  ALL_SCENARIOS,
  EMIT_AXIS,
  EMIT_SCENARIOS,
  HEADLINE,
  TIER1_PEERS,
  TIER2_PEERS,
  TYPED_AXIS,
  TYPED_SCENARIOS,
  compareNullableAsc,
  fingerprint,
  fmtBytes,
  fmtTimeUs,
  formatRatio,
  getEmitRows,
  getMemory,
  getProgressSinceV023,
  getScalingSeries,
  getScenarioDotRows,
  getSpeed,
  getTypedDecodeRows,
  type PeerComparisonRow,
} from '../lib/bench';

const TITLE = 'Benchmarks & Performance | ayaml';
const DESCRIPTION = `Pinned-JSONL throughput, latency, peak heap, allocation count, and 10x linear scaling benchmarks across ${HEADLINE.scenarioCount} timed and ${HEADLINE.memoryScenarioCount} memory YAML workloads.`;

const progressRows = getProgressSinceV023();
const scalingSeries = getScalingSeries();
const scenarioDotRows = getScenarioDotRows();
const emitGroups = EMIT_SCENARIOS.map((sc) => ({ scenario: sc, rows: getEmitRows(sc) }));

function sortPeers(list: PeerComparisonRow[], pick: (r: PeerComparisonRow) => number | null) {
  return [...list].sort((a, b) => compareNullableAsc(pick(a), pick(b)));
}

const TIER2_TABS = [
  {
    id: 'time',
    label: 'Parse time',
    leftHint: 'Faster than ayaml',
    rightHint: 'Slower than ayaml',
    ticks: [0.25, 0.5, 1, 2, 4],
    rows: sortPeers(TIER2_PEERS, (r) => r.speedRatio).map((r) => ({
      label: r.label,
      ratio: r.speedRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean parse time across shared fixtures relative to ayaml (Value DOM) = 1.00x. Terracotta = ayaml, blue = unsafe C++ arena, gray = slower peer.',
  },
  {
    id: 'peak',
    label: 'Peak heap',
    leftHint: 'Less peak heap',
    rightHint: 'More peak heap',
    ticks: [0.25, 0.5, 1, 2],
    rows: sortPeers(TIER2_PEERS, (r) => r.peakRatio).map((r) => ({
      label: r.label,
      ratio: r.peakRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean peak heap bytes across shared memory fixtures relative to ayaml (Value DOM) = 1.00x. Green = peer uses less peak heap; blue = unsafe C++ arena; gray = peer uses more.',
  },
  {
    id: 'allocs',
    label: 'Allocations',
    leftHint: 'Fewer allocations',
    rightHint: 'More allocations',
    ticks: [0.25, 0.5, 1, 2, 4],
    rows: sortPeers(TIER2_PEERS, (r) => r.allocRatio).map((r) => ({
      label: r.label,
      ratio: r.allocRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean heap allocation count relative to ayaml (Value DOM) = 1.00x. Left arrow indicates rapidyaml allocates a handful of C++ arena blocks (2 to 17 per fixture, <0.01x).',
  },
];

const TIER1_TABS = [
  {
    id: 'time',
    label: 'Parse time',
    leftHint: 'Faster than ayaml',
    rightHint: 'Slower than ayaml',
    ticks: [0.25, 0.5, 1, 2, 4, 8],
    rows: sortPeers(TIER1_PEERS, (r) => r.speedRatio).map((r) => ({
      label: r.label,
      ratio: r.speedRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean structural parse time relative to ayaml (spanned events) = 1.00x. Terracotta = ayaml, blue = unsafe C++ arena, gray = slower C peer.',
  },
  {
    id: 'peak',
    label: 'Peak heap',
    leftHint: 'Less peak heap',
    rightHint: 'More peak heap',
    ticks: [0.01, 0.05, 0.25, 1, 2],
    rows: sortPeers(TIER1_PEERS, (r) => r.peakRatio).map((r) => ({
      label: r.label,
      ratio: r.peakRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean peak heap bytes relative to ayaml (spanned events) = 1.00x (green = lower peak, blue = C++ arena). Note: C event loops discard each event immediately (live_bytes = 0) while ayaml collects the document buffer.',
  },
  {
    id: 'allocs',
    label: 'Allocations',
    leftHint: 'Fewer allocations',
    rightHint: 'More allocations',
    ticks: [0.05, 0.2, 1, 5, 25, 100],
    rows: sortPeers(TIER1_PEERS, (r) => r.allocRatio).map((r) => ({
      label: r.label,
      ratio: r.allocRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean heap allocation count relative to ayaml (spanned events) = 1.00x (n/a for reused C++ arena; blue = C++ arena, green = fewer allocs, gray = more allocs).',
  },
];

// Precompute full 23-scenario matrix columns grouped cleanly by Tier 1 (structural/events) vs Tier 2 (DOM/Serde).
const MATRIX_TIER1_COLS = [
  { id: 'ayaml-events', impl: 'ayaml', op: 'events', label: 'ayaml events', isAyaml: true },
  { id: 'ryml-arena', impl: 'rapidyaml', op: 'parse-arena', label: 'rapidyaml arena', isAyaml: false },
  { id: 'libyaml-ev', impl: 'libyaml', op: 'events', label: 'libyaml events', isAyaml: false },
  { id: 'libfyaml-ev', impl: 'libfyaml', op: 'events', label: 'libfyaml events', isAyaml: false },
] as const;

const MATRIX_TIER2_COLS = [
  { id: 'ayaml-value', impl: 'ayaml', op: 'value', label: 'ayaml value', isAyaml: true },
  { id: 'ayaml-serde', impl: 'ayaml', op: 'serde-value', label: 'ayaml serde', isAyaml: true },
  { id: 'fkyaml', impl: 'fkyaml', op: 'parse', label: 'fkYAML', isAyaml: false },
  { id: 'yaml-rust2', impl: 'yaml-rust2', op: 'parse', label: 'yaml-rust2', isAyaml: false },
  { id: 'noyalib', impl: 'noyalib', op: 'value', label: 'noyalib', isAyaml: false },
  { id: 'saphyr', impl: 'saphyr', op: 'parse', label: 'saphyr', isAyaml: false },
  { id: 'fast-yaml', impl: 'fast-yaml-core', op: 'parse', label: 'fast-yaml-core', isAyaml: false },
  { id: 'yaml-serde', impl: 'yaml-serde', op: 'value', label: 'yaml-serde', isAyaml: false },
  { id: 'serde-saphyr', impl: 'serde-saphyr', op: 'serde-json', label: 'serde-saphyr', isAyaml: false },
] as const;

const MATRIX_COLS = [...MATRIX_TIER1_COLS, ...MATRIX_TIER2_COLS];

const scenarioMatrix = ALL_SCENARIOS.map((s) => ({
  ...s,
  cells: MATRIX_COLS.map((c) => {
    const sp = getSpeed(c.impl, c.op, s.id);
    const mm = getMemory(c.impl, c.op, s.id);
    return {
      col: c,
      mib: sp ? sp.throughput_mib_s : null,
      us: sp ? sp.median_ns / 1000 : null,
      peakBytes: mm ? mm.peak_bytes : null,
      allocs: mm ? mm.allocations : null,
    };
  }),
}));

const REPRO_COMMANDS = `# Verify pinned SHA-256 fixture catalog
cargo xtask fixtures --verify

# Run Criterion timing suite and export speed.jsonl
cargo xtask speed --out-dir target/xtask

# Run counting-allocator memory & allocation probe (all 40 catalog fixtures)
cargo xtask memory --suite full --out-dir target/xtask

# Verify 10x linear time & memory scaling
cargo xtask scale --out-dir target/xtask

# Run deterministic steady-state Valgrind Callgrind check
cargo xtask det --base-rev HEAD~1

# Run CI allocation gates locally
python3 tools/check_alloc_baseline.py
tools/check_alloc_corpus.sh`;
---

<BaseLayout title={TITLE} description={DESCRIPTION} canonical={`${SITE_URL}/benchmarks/`}>
  <header class="page-head wrap">
    <span class="sec-kicker">Pinned benchmark artifacts &middot; {fingerprint.captured_date}</span>
    <h1>Benchmarks &amp; Performance</h1>
    <p class="sec-lede">
      Every chart, ratio, and table on this page is computed at build time from pinned,
      SHA-256-verified JSONL artifacts rather than hand-entered numbers (<code>{fingerprint.speed_rows}</code>
      speed rows across <code>{HEADLINE.scenarioCount}</code> timed fixtures and
      <code>{fingerprint.memory_rows}</code> memory rows across
      <code>{HEADLINE.memoryScenarioCount}</code> fixtures, including 1 MiB scaling points).
    </p>
    <nav class="jump-nav" aria-label="On this page">
      <a href="#tier2">Tier 2 DOM</a>
      <a href="#tier1">Tier 1 Structural</a>
      <a href="#typed">Typed Serde</a>
      <a href="#emit">Emission</a>
      <a href="#progress">Since v0.2.3</a>
      <a href="#matrix">23-Scenario Matrix</a>
      <a href="#scaling">10x Scaling</a>
      <a href="#tradeoffs">rapidyaml Trade-offs</a>
      <a href="#reproduce">Methodology &amp; Repro</a>
    </nav>
  </header>

  <section class="wrap summary-kpis">
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-val accent">
          {HEADLINE.vsYamlRust2.toFixed(2)}x-{HEADLINE.vsSerdeSaphyr.toFixed(2)}x
        </div>
        <div class="kpi-label">Ahead of Rust YAML DOMs</div>
        <div class="kpi-sub">
          <code>ayaml value</code> leads <code>yaml-rust2</code> ({HEADLINE.vsYamlRust2.toFixed(2)}x),
          <code>saphyr</code> ({HEADLINE.vsSaphyr.toFixed(2)}x), <code>yaml-serde</code> ({HEADLINE.vsYamlSerde.toFixed(2)}x),
          and <code>serde-saphyr</code> ({HEADLINE.vsSerdeSaphyr.toFixed(2)}x).
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">
          {HEADLINE.vsLibyamlEvents.toFixed(2)}x / {HEADLINE.vsFkyaml.toFixed(2)}x
        </div>
        <div class="kpi-label">Ahead of C libyaml &amp; C++ fkYAML</div>
        <div class="kpi-sub">
          Safe Rust beats C <code>libyaml</code> events ({HEADLINE.vsLibyamlEvents.toFixed(2)}x),
          C <code>libfyaml</code> ({HEADLINE.vsLibfyamlEvents.toFixed(2)}x), and C++
          <code>fkYAML</code> ({HEADLINE.vsFkyaml.toFixed(2)}x) on geometric mean.
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.ciEmitMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">Deterministic YAML emission</div>
        <div class="kpi-sub">
          <code>{HEADLINE.ciEmitVsYamlSerde.toFixed(1)}x</code> faster than <code>yaml-serde</code>
          on CI workflows and <code>{HEADLINE.emitVsFkyamlMin.toFixed(1)}x to {HEADLINE.emitVsFkyamlMax.toFixed(1)}x</code>
          faster than C++ <code>fkYAML</code>.
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.largeScalarMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">1 MiB scalar streaming</div>
        <div class="kpi-sub">
          <code>{HEADLINE.largeScalarVsRyml.toFixed(2)}x</code> faster than C++ <code>rapidyaml</code>
          and <code>{HEADLINE.largeScalarVsLibyaml.toFixed(1)}x</code> faster than
          <code>libyaml</code> on large block scalars.
        </div>
      </div>
    </div>
  </section>

  <section id="tier2" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 2 &middot; Full Semantic / Typed DOM &middot; Log scale vs ayaml (1.00x)</span>
        <h2>Generic <code>Value</code> &amp; Serde DOM comparison</h2>
        <p class="sec-lede">
          Geometric mean across shared fixtures relative to <code>ayaml value</code> (<code>1.00x</code>).
          Bars extending right mean <code>ayaml</code> is faster (or uses less peak heap / fewer
          allocations); bars extending left mean the peer is lower on that metric.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Tier 2 chart metric">
          {
            TIER2_TABS.map((tab, i) => (
              <button
                class="tab-btn"
                type="button"
                role="tab"
                id={`tier2-tab-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`tier2-panel-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          TIER2_TABS.map((tab, i) => (
            <div
              id={`tier2-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`tier2-tab-${tab.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <p class="nojs-panel-title">{tab.label}</p>
              <DivergingRatioChart
                id={`tier2-${tab.id}`}
                title={`Tier 2 ${tab.label.toLowerCase()} comparison vs ayaml value`}
                description={tab.caption}
                baselineLabel="Baseline: ayaml (1.00x)"
                leftHint={tab.leftHint}
                rightHint={tab.rightHint}
                ticks={tab.ticks}
                rows={tab.rows}
                caption={tab.caption}
              />
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Implementation</th>
              <th>Operation</th>
              <th>Language / Safety</th>
              <th class="num">Shared (speed / mem)</th>
              <th class="num">Time vs ayaml</th>
              <th class="num">Peak heap vs ayaml</th>
              <th class="num">Allocs vs ayaml</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER2_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td>{r.safety}</td>
                  <td class="num">
                    {r.sharedScenarios} / {r.memSharedScenarios}
                  </td>
                  <td class="num">{formatRatio(r.speedRatio)}</td>
                  <td class="num">{formatRatio(r.peakRatio)}</td>
                  <td class="num">{formatRatio(r.allocRatio)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="tier1" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 1 &middot; Zero-Copy &amp; Structural Parsing &middot; Log scale vs ayaml events (1.00x)</span>
        <h2>Spanned event stream vs C &amp; C++ structural parsers</h2>
        <p class="sec-lede">
          Geometric mean relative to <code>ayaml events</code> (<code>1.00x</code>).
          <code>ayaml</code>'s pull-based spanned event stream beats both C <code>libyaml</code>
          (<code>{HEADLINE.vsLibyamlEvents.toFixed(2)}x</code> faster with
          <code>{HEADLINE.vsLibyamlEventsAllocs.toFixed(0)}x</code> fewer allocations) and C
          <code>libfyaml</code> (<code>{HEADLINE.vsLibfyamlEvents.toFixed(2)}x</code> faster).
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Tier 1 chart metric">
          {
            TIER1_TABS.map((tab, i) => (
              <button
                class="tab-btn"
                type="button"
                role="tab"
                id={`tier1-tab-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`tier1-panel-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          TIER1_TABS.map((tab, i) => (
            <div
              id={`tier1-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`tier1-tab-${tab.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <p class="nojs-panel-title">{tab.label}</p>
              <DivergingRatioChart
                id={`tier1-${tab.id}`}
                title={`Tier 1 ${tab.label.toLowerCase()} comparison vs ayaml events`}
                description={tab.caption}
                baselineLabel="Baseline: ayaml (1.00x)"
                leftHint={tab.leftHint}
                rightHint={tab.rightHint}
                ticks={tab.ticks}
                rows={tab.rows}
                caption={tab.caption}
              />
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Implementation</th>
              <th>Operation</th>
              <th>Language / Safety</th>
              <th class="num">Shared (speed / mem)</th>
              <th class="num">Time vs ayaml events</th>
              <th class="num">Peak heap vs ayaml events</th>
              <th class="num">Allocs vs ayaml events</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER1_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td>{r.safety}</td>
                  <td class="num">
                    {r.sharedScenarios} / {r.memSharedScenarios}
                  </td>
                  <td class="num">{formatRatio(r.speedRatio)}</td>
                  <td class="num">{formatRatio(r.peakRatio)}</td>
                  <td class="num">{formatRatio(r.allocRatio)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Memory methodology note:</strong> In the Tier 1 memory probe,
        <code>ayaml events</code> collects the document's spanned event buffer
        (<code>live_bytes &gt; 0</code>) whereas C <code>libyaml</code> and <code>libfyaml</code>
        event loops discard each event immediately on every pull (<code>live_bytes = 0</code>),
        accounting for their smaller retained peak ratios despite higher allocation counts.
      </p>
    </div>
  </section>

  <section id="typed" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Typed Rust Serde Decode &middot; Speed &amp; Peak Heap Side-by-Side</span>
        <h2>Owned &amp; zero-copy borrowed struct deserialization</h2>
        <p class="sec-lede">
          Direct struct decoding across small frontmatter and the 4 KiB streaming boundary. All
          three scenario tabs share a fixed <code>0 to {TYPED_AXIS.throughputMax} MiB/s</code> speed
          axis and <code>0 to {TYPED_AXIS.peakKibMax} KiB</code> peak-heap axis so the
          {HEADLINE.typedStreamingHeapDropPct.toFixed(0)}% streaming heap drop above 4 KiB and up to
          <code>{HEADLINE.typedMaxPeakSavingsVsYamlSerde.toFixed(1)}x</code> peak-heap savings vs
          <code>yaml-serde</code> are directly comparable.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Typed decode scenario">
          {
            TYPED_SCENARIOS.map((sc, i) => {
              const meta = ALL_SCENARIOS.find((s) => s.id === sc.id);
              const sizeStr = meta ? fmtBytes(meta.bytes) : '';
              return (
                <button
                  class="tab-btn"
                  type="button"
                  role="tab"
                  id={`typed-tab-${sc.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`typed-panel-${sc.id}`}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {sc.label} ({sizeStr})
                </button>
              );
            })
          }
        </div>
        {
          TYPED_SCENARIOS.map((sc, i) => {
            const rows = getTypedDecodeRows(sc.id);
            const meta = ALL_SCENARIOS.find((s) => s.id === sc.id);
            const sizeStr = meta ? fmtBytes(meta.bytes) : sc.id;
            return (
              <div
                id={`typed-panel-${sc.id}`}
                role="tabpanel"
                aria-labelledby={`typed-tab-${sc.id}`}
                tabindex="0"
                hidden={i !== 0}
              >
                <p class="nojs-panel-title">
                  {sc.label} ({sizeStr})
                </p>
                <DualMetricBarChart
                  id={`typed-${sc.id}`}
                  title={`Typed Serde throughput and peak heap for ${sc.label}`}
                  description={`Side-by-side throughput (MiB/s) and peak heap (KiB) with allocation counts for ${sc.label} (${sizeStr}).`}
                  rows={rows}
                  throughputMax={TYPED_AXIS.throughputMax}
                  peakKibMax={TYPED_AXIS.peakKibMax}
                  caption={`Scenario: ${sc.id} (${sizeStr}). Shared axes across all three tabs (0 to ${TYPED_AXIS.throughputMax} MiB/s and 0 to ${TYPED_AXIS.peakKibMax} KiB) make cross-size memory shifts visible.`}
                />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="emit" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Serialization &amp; Emission &middot; Higher = faster</span>
        <h2>Deterministic YAML emission throughput</h2>
        <p class="sec-lede">
          Higher is faster (MiB/s). <code>ayaml</code> emits canonical output with YAML 1.1-safe
          leading-zero numeral quoting at
          <code>{HEADLINE.emitMinMib.toFixed(0)} to {HEADLINE.emitMaxMib.toFixed(0)} MiB/s</code>:
          <code>{HEADLINE.emitVsFkyamlMin.toFixed(1)}x to {HEADLINE.emitVsFkyamlMax.toFixed(1)}x</code>
          faster than C++ <code>fkYAML</code>,
          <code>{HEADLINE.emitVsNoyalibMin.toFixed(1)}x to {HEADLINE.emitVsNoyalibMax.toFixed(1)}x</code>
          faster than <code>noyalib</code>, and
          <code>{HEADLINE.emitVsYamlSerdeMin.toFixed(1)}x to {HEADLINE.emitVsYamlSerdeMax.toFixed(1)}x</code>
          faster than <code>yaml-serde</code>.
        </p>
      </div>

      <GroupedBarChart
        id="emit-throughput"
        title="YAML emission throughput across frontmatter, CI workflow, and OpenAPI fixtures"
        description="Grouped horizontal bar chart comparing YAML emission throughput in MiB/s across rapidyaml, ayaml, fkYAML, noyalib, and yaml-serde."
        groups={emitGroups}
        tickMax={EMIT_AXIS.tickMax}
        caption="Median emission throughput (MiB/s) across three representative fixtures. rapidyaml emits from an unsafe C++ arena; ayaml emits canonical YAML 1.2.2 in safe Rust."
      />
    </div>
  </section>

  <section id="progress" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Progress since v0.2.3 &middot; Baseline 1.0x = v0.2.3</span>
        <h2>Speedups &amp; memory reductions since <code>v0.2.3</code></h2>
        <p class="sec-lede">
          Same hardware, same compiler (<code>{fingerprint.rustc}</code>), same SHA-256 verified
          fixtures comparing <code>v0.2.3</code> (<code>{fingerprint.baseline_v023_git_sha.slice(0, 8)}</code>)
          against the current engine (<code>{fingerprint.public_git_sha.slice(0, 8)}</code>).
          Across all <code>{HEADLINE.v023SpeedRowCount}</code> shared speed rows, geometric-mean
          speedup is <strong>{HEADLINE.v023OverallSpeedup.toFixed(2)}x</strong> (range
          <code>{HEADLINE.v023MinSpeedup.toFixed(2)}x to {HEADLINE.v023MaxSpeedup.toFixed(2)}x</code>,
          zero regressions), with <strong>{HEADLINE.v023PeakImprovement.toFixed(2)}x</strong>
          geometric-mean peak-heap improvement across <code>{HEADLINE.v023MemoryRowCount}</code>
          memory rows. Top highlights sorted by speedup:
        </p>
      </div>

      <SpeedupBulletChart
        id="progress-v023"
        title="Speedups and peak-heap reductions since ayaml v0.2.3"
        description="Lollipop range chart anchored at 1.0x (v0.2.3) showing speedup factor, old to current throughput in MiB/s, and peak-heap reduction badges."
        rows={progressRows}
        caption="All 10 highlighted workloads anchored at v0.2.3 = 1.0x. Green pills show peak-heap reduction where peak bytes dropped by more than 2%; n/a marks emit rows not included in the memory probe."
      />
    </div>
  </section>

  <section id="matrix" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Full dataset &middot; All {HEADLINE.scenarioCount} timed scenarios</span>
        <h2>Per-scenario throughput, latency, peak heap, and allocations</h2>
        <p class="sec-lede">
          Inspect the log-scale visual map across all {HEADLINE.scenarioCount} timed scenarios or
          switch to the full numeric tables grouped by Tier 1 (structural / event parsers) and
          Tier 2 (full Value / Serde DOM parsers).
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Matrix metric selector">
          <button class="tab-btn" type="button" role="tab" id="mat-tab-visual" aria-selected="true" aria-controls="mat-panel-visual" tabindex="0">
            Visual map (CPU speed)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-mib" aria-selected="false" aria-controls="mat-panel-mib" tabindex="-1">
            Throughput (MiB/s)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-us" aria-selected="false" aria-controls="mat-panel-us" tabindex="-1">
            Median latency (µs / ms)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-peak" aria-selected="false" aria-controls="mat-panel-peak" tabindex="-1">
            Peak heap (KiB / MiB)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-allocs" aria-selected="false" aria-controls="mat-panel-allocs" tabindex="-1">
            Heap allocations (count)
          </button>
        </div>

        <div
          id="mat-panel-visual"
          role="tabpanel"
          aria-labelledby="mat-tab-visual"
          tabindex="0"
        >
          <p class="nojs-panel-title">Visual map (all {HEADLINE.scenarioCount} timed scenarios)</p>
          <ScenarioDotStrip
            id="matrix-dot-strip"
            title={`Per-scenario relative parse time across all ${HEADLINE.scenarioCount} timed workloads`}
            description={`Dot strip plotting peer parse time relative to ayaml value = 1.0x on a log2 scale from 0.25x to 16x across all ${HEADLINE.scenarioCount} pinned scenarios.`}
            rows={scenarioDotRows}
            caption="Each row plots peer median parse time divided by ayaml value median parse time (log2 axis, 0.25x to 16x). Hover any marker for exact ratio; switch tabs above for complete numeric tables."
          />
        </div>

        {
          [
            { id: 'mib', title: 'Throughput (MiB/s)', fmt: (c: typeof scenarioMatrix[0]['cells'][0]) => (c.mib !== null ? c.mib.toFixed(1) : 'n/a') },
            { id: 'us', title: 'Median latency (µs / ms)', fmt: (c: typeof scenarioMatrix[0]['cells'][0]) => (c.us !== null ? fmtTimeUs(c.us) : 'n/a') },
            { id: 'peak', title: 'Peak heap (KiB / MiB)', fmt: (c: typeof scenarioMatrix[0]['cells'][0]) => (c.peakBytes !== null ? fmtBytes(c.peakBytes) : 'n/a') },
            { id: 'allocs', title: 'Heap allocations (count)', fmt: (c: typeof scenarioMatrix[0]['cells'][0]) => (c.allocs !== null ? c.allocs.toLocaleString('en-US') : 'n/a') },
          ].map((metric) => (
            <div
              id={`mat-panel-${metric.id}`}
              role="tabpanel"
              aria-labelledby={`mat-tab-${metric.id}`}
              tabindex="0"
              hidden
            >
              <p class="nojs-panel-title">{metric.title}</p>
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr class="tier-group-row">
                      <th colspan="2">Workload</th>
                      <th colspan={MATRIX_TIER1_COLS.length} class="tier-group">
                        Tier 1 &middot; Structural / Events
                      </th>
                      <th colspan={MATRIX_TIER2_COLS.length} class="tier-group">
                        Tier 2 &middot; Value / Serde DOM
                      </th>
                    </tr>
                    <tr>
                      <th>Scenario</th>
                      <th class="num">Size</th>
                      {MATRIX_COLS.map((c) => <th class="num">{c.label}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {scenarioMatrix.map((row) => (
                      <tr>
                        <td><code>{row.id}</code></td>
                        <td class="num">{fmtBytes(row.bytes)}</td>
                        {row.cells.map((cell) => (
                          <td class:list={['num', { 'col-ayaml': cell.col.isAyaml }]}>
                            {metric.fmt(cell)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="scaling" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Complexity verification</span>
        <h2>10x linear scaling ladder (10 KiB &rarr; 100 KiB &rarr; 1 MiB)</h2>
        <p class="sec-lede">
          Normalized growth when input size increases by 10x (<code>1.00x</code> = ideal O(n) scaling).
          Amortized arena and table capacity jumps between 10 KiB and 100 KiB settle below
          <code>1.00x</code> from 100 KiB to 1 MiB. Verified automatically by
          <code>cargo xtask scale</code>.
        </p>
      </div>

      <ScalingPlot
        id="scaling-ladder"
        title="10x linear scaling for peak heap and parse time across 10 KiB, 100 KiB, and 1 MiB workloads"
        description="Two-panel plot showing log-log peak heap growth alongside an O(n) slope guide on the left, and normalized 10x step ratios relative to 1.00x on the right."
        series={scalingSeries}
        caption="Left: peak heap scales parallel to the O(n) slope guide across two orders of magnitude. Right: every 100 KiB to 1 MiB peak-heap step settles at or below 1.00x."
      />

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Workload family</th>
              <th class="num">10 KiB &rarr; 100 KiB time</th>
              <th class="num">10 KiB &rarr; 100 KiB peak</th>
              <th class="num">100 KiB &rarr; 1 MiB peak</th>
            </tr>
          </thead>
          <tbody>
            {
              scalingSeries.map((s) => (
                <tr>
                  <td><strong>{s.family}</strong></td>
                  <td class="num">
                    {s.time10to100 !== null ? (
                      <span class="pill pill-green">{s.time10to100.toFixed(2)}x</span>
                    ) : (
                      'n/a'
                    )}
                  </td>
                  <td class="num">
                    <span class="pill pill-muted">{s.peak10to100.toFixed(2)}x</span>
                  </td>
                  <td class="num">
                    <span class="pill pill-green">{s.peak100to1m.toFixed(2)}x</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="tradeoffs" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Architecture trade-offs</span>
        <h2>Why C++ arena parsers (<code>rapidyaml</code>) differ on structured workloads</h2>
      </div>

      <div class="callout blue">
        <h3>Safety, conformance, and ownership vs. raw mutable byte arenas</h3>
        <p>
          On geometric mean across the {HEADLINE.scenarioCount}-fixture suite, <code>ayaml</code> is
          faster than every measured Rust YAML library, C <code>libyaml</code>, C
          <code>libfyaml</code>, and C++ <code>fkYAML</code>. On dense multi-node documents, C++
          <code>rapidyaml</code> stays about
          <code>{HEADLINE.rymlAheadOfEvents.toFixed(2)}x to {HEADLINE.rymlAheadOfValue.toFixed(2)}x</code>
          faster on geometric mean because its output model does much less per-node work. It parses
          raw bytes into a flat, unsafe C++ index arena (optionally mutating the input buffer in
          place) with a handful of arena allocations (2 to 17 across fixtures), skipping Rust UTF-8 ownership checks, duplicate-key
          hashing, YAML 1.2.2 Core schema resolution on the arena path, and owned per-node
          <code>Value</code> / <code>Mapping</code> structures.
        </p>
        <p>
          <code>ayaml</code> enforces <code>#![forbid(unsafe_code)]</code>, YAML 1.2.2 Core schema
          semantics, duplicate mapping-key rejection, byte-accurate spans, bounded alias-expansion
          budgets, and full Serde integration. When input is dominated by bulk text rather than
          small nodes (such as <code>large-scalar-1mb</code>), <code>ayaml</code> runs at
          <strong>{HEADLINE.largeScalarMib.toFixed(1)} MiB/s</strong>, more than
          <strong>{HEADLINE.largeScalarVsRyml.toFixed(1)}x faster than rapidyaml</strong>.
        </p>
      </div>
    </div>
  </section>

  <section id="reproduce" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Provenance &amp; reproducibility</span>
        <h2>Hardware, compiler, and local verification commands</h2>
      </div>

      <div class="prov-grid">
        <div class="table-wrap">
          <table class="data-table">
            <tbody>
              <tr>
                <th>CPU &amp; architecture</th>
                <td>
                  {fingerprint.cpu} ({fingerprint.os}/{fingerprint.arch}, {fingerprint.cpu_count}
                  logical cores)
                </td>
              </tr>
              <tr>
                <th>Isolation</th>
                <td>
                  Pinned CPU core <code>{fingerprint.cpu_pin}</code>,
                  <code>{fingerprint.governor}</code> frequency governor
                </td>
              </tr>
              <tr><th>Rust compiler</th><td><code>{fingerprint.rustc}</code></td></tr>
              <tr><th>Measured commit</th><td><code>{fingerprint.public_git_sha}</code></td></tr>
              <tr><th>v0.2.3 baseline commit</th><td><code>{fingerprint.baseline_v023_git_sha}</code></td></tr>
              <tr><th>Fixture manifest SHA-256</th><td><code>{fingerprint.fixture_manifest_sha256}</code></td></tr>
              <tr>
                <th>Detailed methodology</th>
                <td><a href={`${BASE}/docs/benchmarks/`}>Benchmark methodology guide</a></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="code-frame">
          <div class="code-bar">
            <span>Reproduce locally</span>
            <button class="copy-btn" type="button" data-copy={REPRO_COMMANDS}>Copy commands</button>
          </div>
          <Code
            code={REPRO_COMMANDS}
            lang="bash"
            themes={{ light: 'github-light', dark: 'github-dark' }}
            defaultColor={false}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

