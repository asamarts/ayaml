---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import DivergingRatioChart from '../components/charts/DivergingRatioChart.astro';
import DualMetricBarChart from '../components/charts/DualMetricBarChart.astro';
import GroupedBarChart from '../components/charts/GroupedBarChart.astro';
import SpeedupBulletChart from '../components/charts/SpeedupBulletChart.astro';
import ScalingPlot from '../components/charts/ScalingPlot.astro';
import ScenarioDotStrip from '../components/charts/ScenarioDotStrip.astro';
import { BASE, SITE_URL } from '../lib/site';
import {
  ALL_SCENARIOS,
  EMIT_AXIS,
  EMIT_SCENARIOS,
  HEADLINE,
  TIER1_PEERS,
  TIER2_PEERS,
  TYPED_AXIS,
  TYPED_SCENARIOS,
  compareNullableAsc,
  fingerprint,
  fmtBytes,
  fmtTimeUs,
  formatRatio,
  getEmitRows,
  getMemory,
  getProgressSinceV023,
  getScalingSeries,
  getScenarioDotRows,
  getSpeed,
  getTypedDecodeRows,
  type PeerComparisonRow,
} from '../lib/bench';

const TITLE = 'Benchmarks & Performance | ayaml';
const DESCRIPTION = `Pinned-JSONL throughput, latency, peak heap, allocation count, and 10x linear scaling benchmarks across ${HEADLINE.scenarioCount} timed and ${HEADLINE.memoryScenarioCount} memory YAML workloads.`;

const progressRows = getProgressSinceV023();
const scalingSeries = getScalingSeries();
const scalingTimeSteps = scalingSeries
  .flatMap((s) => [s.time10to100, s.time100to1m])
  .filter((v): v is number => v !== null);
const scalingTimeMin = Math.min(...scalingTimeSteps);
const scalingTimeMax = Math.max(...scalingTimeSteps);
const scenarioDotRows = getScenarioDotRows();
const emitGroups = EMIT_SCENARIOS.map((sc) => ({ scenario: sc, rows: getEmitRows(sc) }));

const HARNESS_REPO = fingerprint.harness_repo ?? 'https://github.com/asamarts/ayaml-benchmarks';
const HARNESS_SHA = fingerprint.harness_git_sha ?? '';
const PEER_VERSION_ENTRIES = Object.entries(fingerprint.peer_versions ?? {});

function sortPeers(list: PeerComparisonRow[], pick: (r: PeerComparisonRow) => number | null) {
  return [...list].sort((a, b) => compareNullableAsc(pick(a), pick(b)));
}

const TIER2_TABS = [
  {
    id: 'time',
    label: 'Parse time',
    leftHint: 'Faster than ayaml',
    rightHint: 'Slower than ayaml',
    ticks: [0.25, 0.5, 1, 2, 4, 8],
    rows: sortPeers(TIER2_PEERS, (r) => r.speedRatio).map((r) => ({
      label: r.label,
      ratio: r.speedRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean parse time across shared fixtures relative to ayaml (Value DOM) = 1.00x. Terracotta = ayaml, blue = unsafe C++ arena, gray = slower peer.',
  },
  {
    id: 'peak',
    label: 'Peak heap',
    leftHint: 'Less peak heap',
    rightHint: 'More peak heap',
    ticks: [0.5, 1, 2, 4, 8],
    rows: sortPeers(TIER2_PEERS, (r) => r.peakRatio).map((r) => ({
      label: r.label,
      ratio: r.peakRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean peak heap bytes across shared memory fixtures relative to ayaml (Value DOM) = 1.00x. ayaml (Value DOM) uses less peak heap than every measured DOM and arena peer.',
  },
  {
    id: 'allocs',
    label: 'Allocations',
    leftHint: 'Fewer allocations',
    rightHint: 'More allocations',
    ticks: [0.25, 0.5, 1, 2, 4, 8],
    rows: sortPeers(TIER2_PEERS, (r) => r.allocRatio).map((r) => ({
      label: r.label,
      ratio: r.allocRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'value',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean heap allocation count relative to ayaml (Value DOM) = 1.00x. Left arrow indicates rapidyaml allocates a handful of C++ arena blocks (2 to 17 per fixture, <0.01x).',
  },
];

const TIER1_TABS = [
  {
    id: 'time',
    label: 'Parse time',
    leftHint: 'Faster than ayaml',
    rightHint: 'Slower than ayaml',
    ticks: [0.25, 0.5, 1, 2, 4, 8, 16],
    rows: sortPeers(TIER1_PEERS, (r) => r.speedRatio).map((r) => ({
      label: r.label,
      ratio: r.speedRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean structural parse time relative to public pull-based ayaml::parse_events = 1.00x. Terracotta = ayaml, blue = unsafe C++ arena, gray = slower C peer.',
  },
  {
    id: 'peak',
    label: 'Peak heap',
    leftHint: 'Less peak heap',
    rightHint: 'More peak heap',
    ticks: [0.1, 0.25, 1, 4, 16, 32],
    rows: sortPeers(TIER1_PEERS, (r) => r.peakRatio).map((r) => ({
      label: r.label,
      ratio: r.peakRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean peak heap bytes relative to ayaml (pull events) = 1.00x. All three event loops (ayaml, libyaml, libfyaml) pull and discard each event (live_bytes = 0); libfyaml uses a smaller fixed ring buffer, ayaml uses less peak heap than libyaml events and all document/arena modes, and the left arrow on ayaml (scanner only) marks <0.01x peak heap across the 12 non-zero scanner fixtures (14 of 26 allocate 0 bytes).',
  },
  {
    id: 'allocs',
    label: 'Allocations',
    leftHint: 'Fewer allocations',
    rightHint: 'More allocations',
    ticks: [0.25, 1, 4, 16, 64, 256, 1024],
    rows: sortPeers(TIER1_PEERS, (r) => r.allocRatio).map((r) => ({
      label: r.label,
      ratio: r.allocRatio,
      isAyaml: r.isAyaml,
      isBaseline: r.impl === 'ayaml' && r.op === 'events',
      isUnsafeArena: r.isUnsafeArena,
    })),
    caption: 'Log-scale geometric-mean heap allocation count relative to ayaml (pull events) = 1.00x (n/a for reused C++ arena; blue = C++ arena, gray = more allocs).',
  },
];

// Full scenario matrix columns grouped by Tier 1 (structural/events) vs Tier 2 (DOM/Serde).
const MATRIX_TIER1_COLS = [
  { id: 'ayaml-events', impl: 'ayaml', op: 'events', label: 'ayaml events', isAyaml: true },
  { id: 'ryml-arena', impl: 'rapidyaml', op: 'parse-arena', label: 'rapidyaml arena', isAyaml: false },
  { id: 'libyaml-ev', impl: 'libyaml', op: 'events', label: 'libyaml events', isAyaml: false },
  { id: 'libfyaml-ev', impl: 'libfyaml', op: 'events', label: 'libfyaml events', isAyaml: false },
] as const;

const MATRIX_TIER2_COLS = [
  { id: 'ayaml-value', impl: 'ayaml', op: 'value', label: 'ayaml value', isAyaml: true },
  { id: 'ayaml-serde', impl: 'ayaml', op: 'serde-value', label: 'ayaml serde', isAyaml: true },
  { id: 'fkyaml', impl: 'fkyaml', op: 'parse', label: 'fkYAML', isAyaml: false },
  { id: 'yaml-rust2', impl: 'yaml-rust2', op: 'parse', label: 'yaml-rust2', isAyaml: false },
  { id: 'noyalib', impl: 'noyalib', op: 'value', label: 'noyalib', isAyaml: false },
  { id: 'saphyr', impl: 'saphyr', op: 'parse', label: 'saphyr', isAyaml: false },
  { id: 'fast-yaml', impl: 'fast-yaml-core', op: 'parse', label: 'fast-yaml-core', isAyaml: false },
  { id: 'yaml-serde', impl: 'yaml-serde', op: 'value', label: 'yaml-serde', isAyaml: false },
  { id: 'serde-saphyr', impl: 'serde-saphyr', op: 'serde-json', label: 'serde-saphyr', isAyaml: false },
] as const;

const MATRIX_COLS = [...MATRIX_TIER1_COLS, ...MATRIX_TIER2_COLS];

const scenarioMatrix = ALL_SCENARIOS.map((s) => ({
  ...s,
  cells: MATRIX_COLS.map((c) => {
    const sp = getSpeed(c.impl, c.op, s.id);
    const mm = getMemory(c.impl, c.op, s.id);
    return {
      col: c,
      mib: sp ? sp.throughput_mib_s : null,
      us: sp ? sp.median_ns / 1000 : null,
      peakBytes: mm ? mm.peak_bytes : null,
      allocs: mm ? mm.allocations : null,
    };
  }),
}));

const REPRO_COMMANDS = `# 1. Pure-Rust ayaml benchmarks & fixture catalog (inside asamarts/ayaml)
cargo xtask fixtures --verify
cargo xtask speed --out-dir target/xtask
cargo xtask memory --suite full --out-dir target/xtask
cargo xtask scale --out-dir target/xtask
cargo xtask det --suite pr --base HEAD~1

# 2. Full 11-parser Rust/C/C++ comparative harness (standalone repository)
git clone ${HARNESS_REPO}.git
cd ayaml-benchmarks
git checkout ${HARNESS_SHA || 'main'}
cargo test --workspace --all-features --locked
./scripts/run_benchmarks.sh --rounds ${fingerprint.criterion?.rounds ?? 3} --cpu ${fingerprint.cpu_pin}`;
---

<BaseLayout title={TITLE} description={DESCRIPTION} canonical={`${SITE_URL}/benchmarks/`}>
  <header class="page-head wrap">
    <span class="sec-kicker">
      Pinned benchmark artifacts &middot; {fingerprint.captured_date} &middot; {fingerprint.criterion?.rounds ?? 3} rounds
    </span>
    <h1>Benchmarks &amp; Performance</h1>
    <p class="sec-lede">
      Every chart, ratio, and table on this page is computed at build time from pinned,
      SHA-256-verified JSONL artifacts rather than hand-entered numbers (<code>{fingerprint.speed_rows}</code>
      speed rows across <code>{HEADLINE.scenarioCount}</code> timed fixtures including 1 MiB
      scaling points, and <code>{fingerprint.memory_rows}</code> memory rows across all
      <code>{HEADLINE.memoryScenarioCount}</code> fixtures plus YAML emission).
    </p>
    <nav class="jump-nav" aria-label="On this page">
      <a href="#tier2">Tier 2 DOM</a>
      <a href="#tier1">Tier 1 Structural</a>
      <a href="#typed">Typed Serde</a>
      <a href="#emit">Emission</a>
      <a href="#progress">Since v0.2.3</a>
      <a href="#matrix">{HEADLINE.scenarioCount}-Scenario Matrix</a>
      <a href="#scaling">10x Scaling</a>
      <a href="#tradeoffs">rapidyaml Trade-offs</a>
      <a href="#reproduce">Environment &amp; Methodology</a>
    </nav>
  </header>

  <section class="wrap summary-kpis">
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-val accent">
          {HEADLINE.vsYamlRust2.toFixed(2)}x-{HEADLINE.vsSerdeSaphyr.toFixed(2)}x
        </div>
        <div class="kpi-label">Ahead of Rust DOM &amp; Serde peers</div>
        <div class="kpi-sub">
          <code>ayaml value</code> leads <code>yaml-rust2</code> ({HEADLINE.vsYamlRust2.toFixed(2)}x),
          <code>saphyr</code> ({HEADLINE.vsSaphyr.toFixed(2)}x), <code>yaml-serde</code> ({HEADLINE.vsYamlSerde.toFixed(2)}x),
          and <code>serde-saphyr</code> ({HEADLINE.vsSerdeSaphyr.toFixed(2)}x, targeting <code>serde_json::Value</code>)
          with the lowest peak heap of any measured DOM.
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">
          {HEADLINE.vsLibyamlEvents.toFixed(2)}x / {HEADLINE.vsFkyaml.toFixed(2)}x
        </div>
        <div class="kpi-label">Ahead of C libyaml &amp; C++ fkYAML</div>
        <div class="kpi-sub">
          Public pull-based <code>ayaml::parse_events</code> beats C <code>libyaml</code> events
          ({HEADLINE.vsLibyamlEvents.toFixed(2)}x overall, {HEADLINE.vsLibyamlEventsExclLargeScalar.toFixed(2)}x
          excluding <code>large-scalar-1mb</code>) and C <code>libfyaml</code> ({HEADLINE.vsLibfyamlEvents.toFixed(2)}x);
          <code>ayaml value</code> beats C++ <code>fkYAML</code> ({HEADLINE.vsFkyaml.toFixed(2)}x).
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.ciEmitMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">Deterministic YAML emission</div>
        <div class="kpi-sub">
          <code>{HEADLINE.ciEmitVsYamlSerde.toFixed(1)}x</code> faster than <code>yaml-serde</code>
          on CI workflows and <code>{HEADLINE.emitVsFkyamlMin.toFixed(1)}x to {HEADLINE.emitVsFkyamlMax.toFixed(1)}x</code>
          faster than C++ <code>fkYAML</code>.
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.largeScalarMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">1 MiB plain scalar streaming</div>
        <div class="kpi-sub">
          On the single-line <code>large-scalar-1mb</code> plain scalar: <code>{HEADLINE.largeScalarVsLibfyaml.toFixed(2)}x</code>
          vs C <code>libfyaml</code> events ({HEADLINE.largeScalarLibfyamlMib.toFixed(0)} MiB/s),
          <code>{HEADLINE.largeScalarVsRyml.toFixed(2)}x</code> vs C++ <code>rapidyaml</code>, and
          <code>{HEADLINE.largeScalarVsLibyaml.toFixed(1)}x</code> vs <code>libyaml</code>.
        </div>
      </div>
    </div>
  </section>

  <section id="tier2" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 2 &middot; Full Semantic / Typed DOM &middot; Log scale vs ayaml (1.00x)</span>
        <h2>Generic <code>Value</code> &amp; Serde DOM comparison</h2>
        <p class="sec-lede">
          Geometric mean across shared fixtures relative to <code>ayaml value</code> (<code>1.00x</code>).
          Bars extending right mean <code>ayaml</code> is faster (or uses less peak heap / fewer
          allocations); bars extending left mean the peer is lower on that metric.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Tier 2 chart metric">
          {
            TIER2_TABS.map((tab, i) => (
              <button
                class="tab-btn"
                type="button"
                role="tab"
                id={`tier2-tab-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`tier2-panel-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          TIER2_TABS.map((tab, i) => (
            <div
              id={`tier2-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`tier2-tab-${tab.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <p class="nojs-panel-title">{tab.label}</p>
              <DivergingRatioChart
                id={`tier2-${tab.id}`}
                title={`Tier 2 ${tab.label.toLowerCase()} comparison vs ayaml value`}
                description={tab.caption}
                baselineLabel="Baseline: ayaml (1.00x)"
                leftHint={tab.leftHint}
                rightHint={tab.rightHint}
                ticks={tab.ticks}
                rows={tab.rows}
                caption={tab.caption}
              />
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table" aria-label="Tier 2 Value and Serde DOM comparison vs ayaml value">
          <thead>
            <tr>
              <th scope="col">Implementation</th>
              <th scope="col">Operation</th>
              <th scope="col">Language / Safety</th>
              <th scope="col" class="num">Shared (speed / mem)</th>
              <th scope="col" class="num">Time vs ayaml</th>
              <th scope="col" class="num">Peak heap vs ayaml</th>
              <th scope="col" class="num">Allocs vs ayaml</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER2_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td>{r.safety}</td>
                  <td class="num">
                    {r.sharedScenarios} / {r.memSharedScenarios}
                  </td>
                  <td class="num">{formatRatio(r.speedRatio)}</td>
                  <td class="num">{formatRatio(r.peakRatio)}</td>
                  <td class="num">{formatRatio(r.allocRatio)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Target &amp; semantics note:</strong> <code>serde-saphyr</code> targets
        <code>serde_json::Value</code> because it does not expose a native YAML <code>Value</code>
        DOM. <code>fkYAML</code> is benchmarked on DOM construction and drop with O(1) root
        inspection (no post-parse tree walk). See <a href="#reproduce">Environment &amp; Methodology</a>
        for exact peer exclusions and duplicate-key / map-ordering differences.
      </p>
    </div>
  </section>

  <section id="tier1" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 1 &middot; Zero-Copy &amp; Structural Parsing &middot; Log scale vs ayaml events (1.00x)</span>
        <h2>Pull event stream vs C &amp; C++ structural parsers</h2>
        <p class="sec-lede">
          Geometric mean relative to public pull-based <code>ayaml::parse_events</code> (<code>1.00x</code>).
          <code>ayaml</code> beats C <code>libyaml</code> events on all three axes
          (<code>{HEADLINE.vsLibyamlEvents.toFixed(2)}x</code> faster overall,
          <code>{HEADLINE.vsLibyamlEventsExclLargeScalar.toFixed(2)}x</code> excluding
          <code>large-scalar-1mb</code>, with <code>{HEADLINE.vsLibyamlEventsPeak.toFixed(2)}x</code>
          lower peak heap and <code>{HEADLINE.vsLibyamlEventsAllocs.toFixed(0)}x</code> fewer
          allocations) and beats C <code>libfyaml</code> events by
          <code>{HEADLINE.vsLibfyamlEvents.toFixed(2)}x</code>.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Tier 1 chart metric">
          {
            TIER1_TABS.map((tab, i) => (
              <button
                class="tab-btn"
                type="button"
                role="tab"
                id={`tier1-tab-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`tier1-panel-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          TIER1_TABS.map((tab, i) => (
            <div
              id={`tier1-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`tier1-tab-${tab.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <p class="nojs-panel-title">{tab.label}</p>
              <DivergingRatioChart
                id={`tier1-${tab.id}`}
                title={`Tier 1 ${tab.label.toLowerCase()} comparison vs ayaml events`}
                description={tab.caption}
                baselineLabel="Baseline: ayaml (1.00x)"
                leftHint={tab.leftHint}
                rightHint={tab.rightHint}
                ticks={tab.ticks}
                rows={tab.rows}
                caption={tab.caption}
              />
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table" aria-label="Tier 1 pull events and structural parser comparison vs ayaml events">
          <thead>
            <tr>
              <th scope="col">Implementation</th>
              <th scope="col">Operation</th>
              <th scope="col">Language / Safety</th>
              <th scope="col" class="num">Shared (speed / mem)</th>
              <th scope="col" class="num">Time vs ayaml events</th>
              <th scope="col" class="num">Peak heap vs ayaml events</th>
              <th scope="col" class="num">Allocs vs ayaml events</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER1_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td>{r.safety}</td>
                  <td class="num">
                    {r.sharedScenarios} / {r.memSharedScenarios}
                  </td>
                  <td class="num">{formatRatio(r.speedRatio)}</td>
                  <td class="num">{formatRatio(r.peakRatio)}</td>
                  <td class="num">{formatRatio(r.allocRatio)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        <strong>Memory methodology note:</strong> All three Tier 1 event loops
        (<code>ayaml::parse_events</code>, C <code>libyaml</code> events, and C
        <code>libfyaml</code> events) pull and discard each event immediately
        (<code>live_bytes = 0</code>), so peak heap reflects each parser's streaming working set.
        <code>libyaml load</code> retains all documents on multi-document streams
        (all 49 documents in <code>cluster-manifests</code>). <code>ayaml scan</code> shows
        <code>26 / 12</code> shared memory rows because the streaming scanner performs zero heap
        allocations (<code>peak_bytes = 0</code>) on 14 of the 26 fixtures, which are omitted from
        positive log-ratio geometric means.
      </p>
    </div>
  </section>

  <section id="typed" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Typed Rust Serde Decode &middot; Speed &amp; Peak Heap Side-by-Side</span>
        <h2>Owned &amp; zero-copy borrowed struct deserialization</h2>
        <p class="sec-lede">
          Direct struct decoding across tiny frontmatter and the historical 4 KiB boundary fixtures.
          <code>ayaml</code> streams typed reads directly from events at every input size (D107),
          eliminating the old 4 KiB tree-fallback cliff (<code>{HEADLINE.below4kPeakKib.toFixed(1)} KiB</code>
          below 4 KiB and <code>{HEADLINE.above4kPeakKib.toFixed(1)} KiB</code> above 4 KiB) and
          saving up to <code>{HEADLINE.typedMaxPeakSavingsVsYamlSerde.toFixed(1)}x</code> peak heap
          vs <code>yaml-serde</code>. All three tabs share fixed
          <code>0 to {TYPED_AXIS.throughputMax} MiB/s</code> and
          <code>0 to {TYPED_AXIS.peakKibMax} KiB</code> axes, including <code>noyalib (borrowed)</code>
          on every scenario.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Typed decode scenario">
          {
            TYPED_SCENARIOS.map((sc, i) => {
              const meta = ALL_SCENARIOS.find((s) => s.id === sc.id);
              const sizeStr = meta ? fmtBytes(meta.bytes) : '';
              return (
                <button
                  class="tab-btn"
                  type="button"
                  role="tab"
                  id={`typed-tab-${sc.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`typed-panel-${sc.id}`}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {sc.label} ({sizeStr})
                </button>
              );
            })
          }
        </div>
        {
          TYPED_SCENARIOS.map((sc, i) => {
            const rows = getTypedDecodeRows(sc.id);
            const meta = ALL_SCENARIOS.find((s) => s.id === sc.id);
            const sizeStr = meta ? fmtBytes(meta.bytes) : sc.id;
            return (
              <div
                id={`typed-panel-${sc.id}`}
                role="tabpanel"
