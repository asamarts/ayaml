              <tr><th>Isolation</th><td>Pinned CPU core <code>{fingerprint.cpu_pin}</code>, <code>{fingerprint.governor}</code> frequency governor</td></tr>
              <tr><th>Rust compiler</th><td><code>{fingerprint.rustc}</code></td></tr>
              <tr><th>Measured commit</th><td><code>{fingerprint.public_git_sha}</code></td></tr>
              <tr><th>v0.2.3 baseline commit</th><td><code>{fingerprint.baseline_v023_git_sha}</code></td></tr>
              <tr><th>Fixture manifest SHA-256</th><td><code>{fingerprint.fixture_manifest_sha256}</code></td></tr>
              <tr><th>Detailed methodology</th><td><a href={`${BASE}/docs/benchmarks/`}>Benchmark methodology guide</a></td></tr>
            </tbody>
          </table>
        </div>

        <div class="code-frame">
          <div class="code-bar">
