---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, SITE_URL } from '../lib/site';
import {
  ALL_SCENARIOS,
  EMIT_SCENARIOS,
  HEADLINE,
  TIER1_PEERS,
  TIER2_PEERS,
  TYPED_SCENARIOS,
  fingerprint,
  fmtBytes,
  fmtTimeUs,
  getEmitRows,
  getMemory,
  getProgressSinceV023,
  getScalingSteps,
  getSpeed,
  getTypedDecodeRows,
} from '../lib/bench';

const TITLE = 'Benchmarks & Performance | ayaml';
const DESCRIPTION = `Transparent, pinned-JSONL throughput, latency, peak heap, allocation count, and 10x linear scaling benchmarks across ${HEADLINE.scenarioCount} YAML workloads.`;

const maxTier2Ratio = Math.max(...TIER2_PEERS.map((r) => r.speedRatio));
const maxTier1Ratio = Math.max(...TIER1_PEERS.map((r) => r.speedRatio));
const progressRows = getProgressSinceV023();
const maxSpeedup = Math.max(...progressRows.map((r) => r.speedup));
const scalingSteps = getScalingSteps();

// Precompute full 23-scenario matrix columns so users can explore every fixture cleanly.
const MATRIX_COLS = [
  { id: 'ayaml-events', impl: 'ayaml', op: 'events', label: 'ayaml events', isAyaml: true },
  { id: 'ayaml-value', impl: 'ayaml', op: 'value', label: 'ayaml value', isAyaml: true },
  { id: 'ayaml-serde', impl: 'ayaml', op: 'serde-value', label: 'ayaml serde', isAyaml: true },
  { id: 'ryml-arena', impl: 'rapidyaml', op: 'parse-arena', label: 'rapidyaml arena', isAyaml: false },
  { id: 'libyaml-ev', impl: 'libyaml', op: 'events', label: 'libyaml events', isAyaml: false },
  { id: 'fkyaml', impl: 'fkyaml', op: 'parse', label: 'fkYAML', isAyaml: false },
  { id: 'yaml-rust2', impl: 'yaml-rust2', op: 'parse', label: 'yaml-rust2', isAyaml: false },
  { id: 'noyalib', impl: 'noyalib', op: 'value', label: 'noyalib', isAyaml: false },
  { id: 'saphyr', impl: 'saphyr', op: 'parse', label: 'saphyr', isAyaml: false },
  { id: 'yaml-serde', impl: 'yaml-serde', op: 'value', label: 'yaml-serde', isAyaml: false },
  { id: 'serde-saphyr', impl: 'serde-saphyr', op: 'serde-json', label: 'serde-saphyr', isAyaml: false },
] as const;

const scenarioMatrix = ALL_SCENARIOS.map((s) => ({
  ...s,
  cells: MATRIX_COLS.map((c) => {
    const sp = getSpeed(c.impl, c.op, s.id);
    const mm = getMemory(c.impl, c.op, s.id);
    return {
      col: c,
      mib: sp ? sp.throughput_mib_s : null,
      us: sp ? sp.median_ns / 1000 : null,
      peakBytes: mm ? mm.peak_bytes : null,
      allocs: mm ? mm.allocations : null,
    };
  }),
}));

const REPRO_COMMANDS = `# Verify pinned SHA-256 fixture catalog
cargo xtask fixtures --verify

# Run Criterion timing suite and export speed.jsonl
cargo xtask speed --out-dir target/xtask

# Run counting-allocator memory & allocation probe
cargo xtask memory --suite baseline --out-dir target/xtask

# Verify 10x linear time & memory scaling
cargo xtask scale --out-dir target/xtask

# Run deterministic steady-state Valgrind Callgrind check
cargo xtask det --base-rev HEAD~1

# Run CI allocation gates locally
python3 tools/check_alloc_baseline.py
tools/check_alloc_corpus.sh`;
---

<BaseLayout title={TITLE} description={DESCRIPTION} canonical={`${SITE_URL}/benchmarks/`}>
  <header class="page-head wrap">
    <span class="sec-kicker">Pinned benchmark artifacts &middot; {fingerprint.captured_date}</span>
    <h1>Benchmarks &amp; Performance</h1>
    <p class="sec-lede">
      Every chart and number on this page is rendered at build time directly from pinned,
      SHA-256-verified JSONL artifacts (<code>{fingerprint.speed_rows}</code> speed rows and
      <code>{fingerprint.memory_rows}</code> memory rows across <code>{HEADLINE.scenarioCount}</code>
      reproducible fixtures). Nothing is hand-typed.
    </p>
    <nav class="jump-nav" aria-label="On this page">
      <a href="#tier2">Tier 2 DOM</a>
      <a href="#tier1">Tier 1 Structural</a>
      <a href="#typed">Typed Serde</a>
      <a href="#emit">Emission</a>
      <a href="#progress">Since v0.2.3</a>
      <a href="#matrix">23-Scenario Matrix</a>
      <a href="#scaling">10x Scaling</a>
      <a href="#tradeoffs">rapidyaml Trade-offs</a>
      <a href="#reproduce">Methodology &amp; Repro</a>
    </nav>
  </header>

  <section class="wrap summary-kpis">
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-val accent">{HEADLINE.vsYamlRust2.toFixed(2)}x–{HEADLINE.vsSerdeSaphyr.toFixed(2)}x</div>
        <div class="kpi-label">Fastest Rust YAML DOM</div>
        <div class="kpi-sub">
          <code>ayaml value</code> leads <code>yaml-rust2</code> ({HEADLINE.vsYamlRust2.toFixed(2)}x),
          <code>saphyr</code> ({HEADLINE.vsSaphyr.toFixed(2)}x), <code>yaml-serde</code> ({HEADLINE.vsYamlSerde.toFixed(2)}x),
          and <code>serde-saphyr</code> ({HEADLINE.vsSerdeSaphyr.toFixed(2)}x).
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.vsLibyamlEvents.toFixed(2)}x / {HEADLINE.vsFkyaml.toFixed(2)}x</div>
        <div class="kpi-label">Ahead of C libyaml &amp; C++ fkYAML</div>
        <div class="kpi-sub">
          Safe Rust beats C <code>libyaml</code> events ({HEADLINE.vsLibyamlEvents.toFixed(2)}x),
          C <code>libfyaml</code> ({HEADLINE.vsLibfyamlEvents.toFixed(2)}x), and C++ <code>fkYAML</code> ({HEADLINE.vsFkyaml.toFixed(2)}x).
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.ciEmitMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">Deterministic YAML emission</div>
        <div class="kpi-sub">
          <code>{HEADLINE.ciEmitVsYamlSerde.toFixed(1)}x</code> faster than <code>yaml-serde</code> on CI workflows
          and <code>1.4x–1.8x</code> faster than C++ <code>fkYAML</code>.
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-val">{HEADLINE.largeScalarMib.toFixed(1)} MiB/s</div>
        <div class="kpi-label">1 MiB scalar streaming</div>
        <div class="kpi-sub">
          <code>{HEADLINE.largeScalarVsRyml.toFixed(2)}x</code> faster than C++ <code>rapidyaml</code>
          and <code>5.3x</code> faster than <code>libyaml</code> on large block scalars.
        </div>
      </div>
    </div>
  </section>

  <section id="tier2" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 2 &middot; Full Semantic / Typed DOM</span>
        <h2>Generic <code>Value</code> &amp; Serde DOM comparison</h2>
        <p class="sec-lede">
          Geometric mean across all shared fixtures relative to <code>ayaml value</code> (<code>1.00x</code>).
          A ratio above <code>1.00x</code> means <code>ayaml</code> is faster (or uses less peak memory / fewer allocations);
          below <code>1.00x</code> means the peer is faster.
        </p>
      </div>

      <div class="bar-chart">
        {
          TIER2_PEERS.map((row) => (
            <div class:list={['bar-row', { 'is-ayaml': row.isAyaml, 'is-arena': row.isUnsafeArena }]}>
              <div class="bar-name">
                <span>
                  {row.label}
                  {row.isUnsafeArena && <span class="pill pill-blue" style="margin-left: 6px;">C++ arena</span>}
                </span>
                <span class="bar-sub">{row.safety} &middot; {row.sharedScenarios} scenarios</span>
              </div>
              <div class="bar-track" aria-hidden="true">
                <div
                  class="bar-fill"
                  style={`width: ${((row.speedRatio / maxTier2Ratio) * 100).toFixed(1)}%`}
                />
              </div>
              <div class="bar-val">{row.speedRatio.toFixed(2)}x time</div>
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Implementation</th>
              <th>Operation</th>
              <th>Language / Safety</th>
              <th class="num">Shared</th>
              <th class="num">Time vs ayaml</th>
              <th class="num">Peak heap vs ayaml</th>
              <th class="num">Allocs vs ayaml</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER2_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td>{r.safety}</td>
                  <td class="num">{r.sharedScenarios}</td>
                  <td class="num">{r.speedRatio.toFixed(2)}x</td>
                  <td class="num">{r.peakRatio !== null ? `${r.peakRatio.toFixed(2)}x` : 'n/a'}</td>
                  <td class="num">{r.allocRatio !== null ? `${r.allocRatio.toFixed(2)}x` : 'n/a'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="tier1" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Tier 1 &middot; Zero-Copy &amp; Structural Parsing</span>
        <h2>Spanned event stream vs C &amp; C++ structural parsers</h2>
        <p class="sec-lede">
          Geometric mean relative to <code>ayaml events</code> (<code>1.00x</code>).
          <code>ayaml</code>'s pull-based spanned event stream beats both C <code>libyaml</code>
          (<code>{HEADLINE.vsLibyamlEvents.toFixed(2)}x</code> faster with <code>56x</code> fewer allocations)
          and C <code>libfyaml</code> (<code>{HEADLINE.vsLibfyamlEvents.toFixed(2)}x</code> faster).
        </p>
      </div>

      <div class="bar-chart">
        {
          TIER1_PEERS.map((row) => (
            <div class:list={['bar-row', { 'is-ayaml': row.isAyaml, 'is-arena': row.isUnsafeArena }]}>
              <div class="bar-name">
                <span>{row.label}</span>
                <span class="bar-sub">{row.safety} &middot; {row.sharedScenarios} scenarios</span>
              </div>
              <div class="bar-track" aria-hidden="true">
                <div
                  class="bar-fill"
                  style={`width: ${((row.speedRatio / maxTier1Ratio) * 100).toFixed(1)}%`}
                />
              </div>
              <div class="bar-val">{row.speedRatio.toFixed(2)}x time</div>
            </div>
          ))
        }
      </div>

      <div class="table-wrap" style="margin-top: var(--s5);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Implementation</th>
              <th>Operation</th>
              <th class="num">Shared</th>
              <th class="num">Time vs ayaml events</th>
              <th class="num">Peak heap ratio</th>
              <th class="num">Alloc count ratio</th>
            </tr>
          </thead>
          <tbody>
            {
              TIER1_PEERS.map((r) => (
                <tr class:list={[{ 'is-ayaml': r.isAyaml }]}>
                  <td><code>{r.impl}</code></td>
                  <td><code>{r.op}</code></td>
                  <td class="num">{r.sharedScenarios}</td>
                  <td class="num">{r.speedRatio.toFixed(2)}x</td>
                  <td class="num">{r.peakRatio !== null ? `${r.peakRatio.toFixed(2)}x` : 'n/a'}</td>
                  <td class="num">{r.allocRatio !== null ? `${r.allocRatio.toFixed(2)}x` : 'n/a'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="typed" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Typed Rust Serde Decode</span>
        <h2>Owned &amp; zero-copy borrowed struct deserialization</h2>
        <p class="sec-lede">
          Direct struct decoding across small frontmatter and the 4 KiB streaming boundary.
          <code>ayaml::from_str_borrowed</code> and <code>ayaml::from_str</code> lead every measured
          Rust Serde crate in latency and throughput while cutting peak heap by up to <code>7.5x</code>
          compared to <code>yaml-serde</code>.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Typed decode scenario">
          {
            TYPED_SCENARIOS.map((sc, i) => (
              <button
                class="tab-btn"
                type="button"
                role="tab"
                id={`typed-tab-${sc}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`typed-panel-${sc}`}
                tabindex={i === 0 ? 0 : -1}
              >
                {sc}
              </button>
            ))
          }
        </div>
        {
          TYPED_SCENARIOS.map((sc, i) => {
            const rows = getTypedDecodeRows(sc);
            const maxT = Math.max(...rows.map((r) => r.throughput));
            return (
              <div
                id={`typed-panel-${sc}`}
                role="tabpanel"
                aria-labelledby={`typed-tab-${sc}`}
                hidden={i !== 0}
              >
                <div class="bar-chart">
                  {rows.map((r) => (
                    <div class:list={['bar-row', { 'is-ayaml': r.isAyaml }]}>
                      <div class="bar-name">
                        <span>{r.label}</span>
                        <span class="bar-sub">
                          Peak {fmtBytes(r.peakBytes)} &middot; Live {fmtBytes(r.liveBytes)} &middot; {r.allocations} allocs
                        </span>
                      </div>
                      <div class="bar-track" aria-hidden="true">
                        <div class="bar-fill" style={`width: ${((r.throughput / maxT) * 100).toFixed(1)}%`} />
                      </div>
                      <div class="bar-val">{r.throughput.toFixed(1)} MiB/s ({fmtTimeUs(r.medianUs)})</div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="emit" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Serialization &amp; Emission</span>
        <h2>Deterministic YAML emission throughput</h2>
        <p class="sec-lede">
          Higher is faster (MiB/s). <code>ayaml</code> emits canonical, YAML 1.1-safe output at
          106–175 MiB/s — <code>1.4x–1.8x</code> faster than C++ <code>fkYAML</code>,
          <code>1.5x–2.3x</code> faster than <code>noyalib</code>, and
          <code>3.9x–4.5x</code> faster than <code>yaml-serde</code>.
        </p>
      </div>

      <div class="emit-grid">
        {
          EMIT_SCENARIOS.map((sc) => {
            const rows = getEmitRows(sc);
            const maxT = Math.max(...rows.map((r) => r.throughput));
            return (
              <div class="emit-card">
                <h3><code>{sc}</code></h3>
                <div class="bar-chart" style="margin-top: var(--s3);">
                  {rows.map((r) => (
                    <div class:list={['bar-row', { 'is-ayaml': r.isAyaml, 'is-arena': r.isUnsafeArena }]}>
                      <div class="bar-name">
                        <span>{r.label}</span>
                        <span class="bar-sub">{fmtTimeUs(r.medianUs)}</span>
                      </div>
                      <div class="bar-track" aria-hidden="true">
                        <div class="bar-fill" style={`width: ${((r.throughput / maxT) * 100).toFixed(1)}%`} />
                      </div>
                      <div class="bar-val">{r.throughput.toFixed(1)} MiB/s</div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="progress" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Optimization trajectory</span>
        <h2>Speedups since <code>v0.2.3</code></h2>
        <p class="sec-lede">
          Same hardware, same compiler (<code>{fingerprint.rustc}</code>), same SHA-256 verified
          fixtures comparing <code>v0.2.3</code> (<code>{fingerprint.baseline_v023_git_sha.slice(0, 8)}</code>)
          against the pre-1.0 fast-path engine (<code>{fingerprint.public_git_sha.slice(0, 8)}</code>).
        </p>
      </div>

      <div class="bar-chart">
        {
          progressRows.map((r) => (
            <div class="bar-row is-ayaml">
              <div class="bar-name">
                <span>{r.label}</span>
                <span class="bar-sub">
                  {r.v023Mib.toFixed(1)} &rarr; {r.curMib.toFixed(1)} MiB/s
                </span>
              </div>
              <div class="bar-track" aria-hidden="true">
                <div class="bar-fill" style={`width: ${((r.speedup / maxSpeedup) * 100).toFixed(1)}%`} />
              </div>
              <div class="bar-val">{r.speedup.toFixed(2)}x faster</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="matrix" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Full dataset &middot; All {HEADLINE.scenarioCount} scenarios</span>
        <h2>Per-scenario throughput, latency, peak heap, and allocations</h2>
        <p class="sec-lede">
          Switch metrics below to inspect every single workload in the pinned qualification run.
        </p>
      </div>

      <div data-tabs>
        <div class="tab-list" role="tablist" aria-label="Matrix metric selector">
          <button class="tab-btn" type="button" role="tab" id="mat-tab-mib" aria-selected="true" aria-controls="mat-panel-mib" tabindex="0">
            Throughput (MiB/s, higher is faster)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-us" aria-selected="false" aria-controls="mat-panel-us" tabindex="-1">
            Median latency (µs / ms)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-peak" aria-selected="false" aria-controls="mat-panel-peak" tabindex="-1">
            Peak heap (KiB / MiB)
          </button>
          <button class="tab-btn" type="button" role="tab" id="mat-tab-allocs" aria-selected="false" aria-controls="mat-panel-allocs" tabindex="-1">
            Heap allocations (count)
          </button>
        </div>

        <div id="mat-panel-mib" role="tabpanel" aria-labelledby="mat-tab-mib">
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Scenario</th>
                  <th class="num">Size</th>
                  {MATRIX_COLS.map((c) => <th class="num">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  scenarioMatrix.map((row) => (
                    <tr>
                      <td><code>{row.id}</code></td>
                      <td class="num">{fmtBytes(row.bytes)}</td>
                      {row.cells.map((cell) => (
                        <td class:list={['num', { 'col-ayaml': cell.col.isAyaml }]}>
                          {cell.mib !== null ? cell.mib.toFixed(1) : '—'}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div id="mat-panel-us" role="tabpanel" aria-labelledby="mat-tab-us" hidden>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Scenario</th>
                  <th class="num">Size</th>
                  {MATRIX_COLS.map((c) => <th class="num">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  scenarioMatrix.map((row) => (
                    <tr>
                      <td><code>{row.id}</code></td>
                      <td class="num">{fmtBytes(row.bytes)}</td>
                      {row.cells.map((cell) => (
                        <td class:list={['num', { 'col-ayaml': cell.col.isAyaml }]}>
                          {cell.us !== null ? fmtTimeUs(cell.us) : '—'}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div id="mat-panel-peak" role="tabpanel" aria-labelledby="mat-tab-peak" hidden>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Scenario</th>
                  <th class="num">Size</th>
                  {MATRIX_COLS.map((c) => <th class="num">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  scenarioMatrix.map((row) => (
                    <tr>
                      <td><code>{row.id}</code></td>
                      <td class="num">{fmtBytes(row.bytes)}</td>
                      {row.cells.map((cell) => (
                        <td class:list={['num', { 'col-ayaml': cell.col.isAyaml }]}>
                          {cell.peakBytes !== null ? fmtBytes(cell.peakBytes) : '—'}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div id="mat-panel-allocs" role="tabpanel" aria-labelledby="mat-tab-allocs" hidden>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Scenario</th>
                  <th class="num">Size</th>
                  {MATRIX_COLS.map((c) => <th class="num">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  scenarioMatrix.map((row) => (
                    <tr>
                      <td><code>{row.id}</code></td>
                      <td class="num">{fmtBytes(row.bytes)}</td>
                      {row.cells.map((cell) => (
                        <td class:list={['num', { 'col-ayaml': cell.col.isAyaml }]}>
                          {cell.allocs !== null ? cell.allocs.toLocaleString('en-US') : '—'}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="scaling" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Complexity verification</span>
        <h2>10x linear scaling ladder</h2>
        <p class="sec-lede">
          Normalized growth when input size increases by 10x (<code>1.00x</code> = ideal O(n) scaling).
          Verified automatically by <code>cargo xtask scale</code>.
        </p>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Workload family</th>
              <th>Step</th>
              <th class="num">Size ratio</th>
              <th class="num">Normalized time ratio</th>
              <th class="num">Normalized peak-heap ratio</th>
            </tr>
          </thead>
          <tbody>
            {
              scalingSteps.map((s) => (
                <tr>
                  <td><strong>{s.family}</strong></td>
                  <td><code>{s.from}</code> &rarr; <code>{s.to}</code></td>
                  <td class="num">{s.sizeRatio.toFixed(2)}x</td>
                  <td class="num"><span class="pill pill-green">{s.timeNorm.toFixed(2)}x</span></td>
                  <td class="num">{s.peakNorm.toFixed(2)}x</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="tradeoffs" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Architectural transparency</span>
        <h2>Why C++ arena parsers (<code>rapidyaml</code>) differ on structured workloads</h2>
      </div>

      <div class="callout blue">
        <h3>Safety, conformance, and ownership vs. raw mutable byte arenas</h3>
        <p>
          Across all 23 fixtures, <code>ayaml</code> is faster than every measured Rust YAML library,
          C <code>libyaml</code>, C <code>libfyaml</code>, and C++ <code>fkYAML</code>. On dense multi-node
          documents, C++ <code>rapidyaml</code> stays roughly <code>1.6x–2.4x</code> faster because it
          solves a fundamentally different problem: it parses raw bytes into a flat, unsafe C++ index arena
          (optionally mutating the input buffer in place) with 2–3 arena allocations, no Rust UTF-8 ownership
          barriers, no duplicate-key hashing/rejection, no YAML 1.2.2 Core schema resolution on the arena
          path, and no per-node owned Rust <code>Value</code> / <code>Mapping</code> DOM.
        </p>
        <p>
          <code>ayaml</code> enforces <code>#![forbid(unsafe_code)]</code>, strict YAML 1.2.2 Core schema
          semantics, duplicate mapping-key rejection, byte-accurate spans, bounded alias-expansion budgets,
          and full Serde integration. Where input is dominated by bulk text rather than tiny node overhead
          (such as <code>large-scalar-1mb</code>), <code>ayaml</code> already runs at
          <strong>{HEADLINE.largeScalarMib.toFixed(1)} MiB/s</strong> — more than
          <strong>{HEADLINE.largeScalarVsRyml.toFixed(1)}x faster than rapidyaml</strong>.
        </p>
      </div>
    </div>
  </section>

  <section id="reproduce" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-kicker">Provenance &amp; reproducibility</span>
        <h2>Hardware, compiler, and local verification commands</h2>
      </div>

      <div class="prov-grid">
