---
import { fmtTimeUs, type EmitRow } from '../../lib/bench';

export interface EmitGroup {
  scenario: string;
  rows: EmitRow[];
}

interface Props {
  id: string;
  title: string;
  description: string;
  groups: EmitGroup[];
  tickMax: number;
  caption?: string;
}

const { id, title, description, groups, tickMax, caption } = Astro.props;

const SERIES = [
  { impl: 'rapidyaml', label: 'rapidyaml (C++ arena)', color: 'var(--blue)', opacity: '0.84', lx: 14 },
  { impl: 'ayaml', label: 'ayaml (safe Rust)', color: 'var(--accent)', opacity: '0.96', lx: 176 },
  { impl: 'fkyaml', label: 'fkYAML (C++)', color: 'var(--green)', opacity: '0.88', lx: 322 },
  { impl: 'noyalib', label: 'noyalib (Rust)', color: 'var(--ochre)', opacity: '0.88', lx: 444 },
  { impl: 'yaml-serde', label: 'yaml-serde (libyaml)', color: 'var(--ctl)', opacity: '0.96', lx: 576 },
] as const;

const WIDTH = 760;
const LABEL_X = 148;
const PLOT_X = 162;
const PLOT_W = 500;
const TOP = 54;
const BAR_H = 12;
const BAR_GAP = 3;
const GROUP_GAP = 18;
const GROUP_H = SERIES.length * (BAR_H + BAR_GAP) - BAR_GAP;
const BOTTOM = 28;
const HEIGHT = TOP + groups.length * GROUP_H + Math.max(0, groups.length - 1) * GROUP_GAP + BOTTOM;

const ticks: number[] = [];
for (let t = 0; t <= tickMax; t += 50) ticks.push(t);

const xFor = (v: number): number => PLOT_X + (Math.min(Math.max(v, 0), tickMax) / tickMax) * PLOT_W;
---

<figure class="chart-fig">
  <div class="chart-scroll">
    <svg
      class="chart-svg"
      data-chart="grouped-bar"
      role="img"
      aria-labelledby={`${id}-title ${id}-desc`}
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{description}</desc>

      {/* Top horizontal legend */}
      {
        SERIES.map((s) => (
          <g>
            <rect x={s.lx} y="10" width="10" height="10" rx="2" fill={s.color} opacity={s.opacity} />
            <text x={s.lx + 14} y="19" font-size="10.5" font-weight={s.impl === 'ayaml' ? '700' : '500'} fill="var(--text)">
              {s.label}
            </text>
          </g>
        ))
      }

      <text
        x={PLOT_X + PLOT_W}
        y="39"
        font-size="10.5"
        font-weight="600"
        fill="var(--muted)"
        text-anchor="end"
      >
        Throughput (MiB/s, higher = faster) &rarr;
      </text>

      {/* Vertical gridlines & axis labels */}
      {
        ticks.map((t) => {
          const x = xFor(t);
          return (
            <g>
              <line
                x1={x.toFixed(1)}
                y1={TOP - 8}
                x2={x.toFixed(1)}
                y2={HEIGHT - BOTTOM + 4}
                stroke="var(--rule)"
                stroke-width="1"
                stroke-dasharray={t === 0 ? undefined : '2 3'}
              />
              <text
                class="ch-mono"
                x={x.toFixed(1)}
                y={HEIGHT - 8}
                font-size="10"
                fill="var(--muted)"
                text-anchor="middle"
              >
                {t}
              </text>
            </g>
          );
        })
      }

      {/* Scenario groups */}
      {
        groups.map((grp, gIdx) => {
          const gY = TOP + gIdx * (GROUP_H + GROUP_GAP);
          const rowMap = new Map(grp.rows.map((r) => [r.impl, r]));
          return (
            <g>
              {gIdx > 0 && (
                <line
                  x1="8"
                  y1={(gY - GROUP_GAP / 2).toFixed(1)}
                  x2={WIDTH - 8}
                  y2={(gY - GROUP_GAP / 2).toFixed(1)}
                  stroke="var(--rule)"
                  stroke-width="1"
                  opacity="0.7"
                />
              )}
              <text
                class="ch-mono"
                x={LABEL_X}
                y={(gY + GROUP_H / 2 + 4).toFixed(1)}
                font-size="11.5"
                font-weight="600"
                fill="var(--ink)"
                text-anchor="end"
              >
                {grp.scenario}
              </text>
              {SERIES.map((s, sIdx) => {
                const row = rowMap.get(s.impl);
                if (!row) return null;
                const y = gY + sIdx * (BAR_H + BAR_GAP);
                const w = Math.max(2, xFor(row.throughput) - PLOT_X);
                const isAyaml = s.impl === 'ayaml';
                return (
                  <g>
                    <rect
                      x={PLOT_X}
                      y={y}
                      width={w.toFixed(1)}
                      height={BAR_H}
                      rx="2.5"
                      fill={s.color}
                      opacity={s.opacity}
                    />
                    <text
                      class="ch-mono"
                      x={(PLOT_X + w + 6).toFixed(1)}
                      y={(y + BAR_H - 2).toFixed(1)}
                      font-size="10.5"
                      font-weight={isAyaml ? '700' : '500'}
                      fill={isAyaml ? 'var(--accent-strong)' : 'var(--muted)'}
                    >
                      {row.throughput.toFixed(1)} MiB/s
                    </text>
                  </g>
                );
              })}
            </g>
          );
        })
      }
    </svg>
  </div>
  <table class="sr-only">
    <caption>{title}</caption>
    <thead>
      <tr>
        <th>Scenario</th>
        <th>Implementation</th>
        <th>Throughput</th>
        <th>Median latency</th>
      </tr>
    </thead>
    <tbody>
      {
        groups.flatMap((grp) =>
          grp.rows.map((r) => (
            <tr>
              <td>{grp.scenario}</td>
              <td>{r.label}</td>
              <td>{r.throughput.toFixed(1)} MiB/s</td>
              <td>{fmtTimeUs(r.medianUs)}</td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
  {caption && <figcaption class="chart-cap">{caption}</figcaption>}
</figure>
