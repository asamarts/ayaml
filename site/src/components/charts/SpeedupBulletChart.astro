---
import type { ProgressRow } from '../../lib/bench';

interface Props {
  id: string;
  title: string;
  description: string;
  rows: ProgressRow[];
  caption?: string;
}

const { id, title, description, rows, caption } = Astro.props;

const WIDTH = 760;
const LABEL_X = 196;
const PLOT_X = 212;
const PLOT_W = 246;
const SPEEDUP_X = 508;
const THROUGHPUT_X = 638;
const HEAP_X = 648;
const HEAP_W = 104;

const TOP = 42;
const ROW_H = 28;
const BOTTOM = 16;
const HEIGHT = TOP + rows.length * ROW_H + BOTTOM;

const minDomain = 1.0;
const maxSpeedup = Math.max(...rows.map((r) => r.speedup), 2.5);
const maxDomain = Math.ceil(maxSpeedup * 2) / 2 + 0.1;
const ticks: number[] = [];
for (let t = 1.0; t <= Math.ceil(maxSpeedup * 2) / 2 + 0.001; t += 0.5) {
  ticks.push(Number(t.toFixed(1)));
}

const xFor = (v: number): number =>
  PLOT_X + ((Math.min(Math.max(v, minDomain), maxDomain) - minDomain) / (maxDomain - minDomain)) * PLOT_W;
---

<figure class="chart-fig">
  <div class="chart-scroll">
    <svg
      class="chart-svg"
      data-chart="speedup-bullet"
      role="img"
      aria-labelledby={`${id}-title ${id}-desc`}
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{description}</desc>

      {/* Column headers */}
      <text x={PLOT_X} y="15" font-size="10.5" font-weight="700" fill="var(--ink)">
        Speedup vs v0.2.3 (1.0x baseline)
      </text>
      <text x={SPEEDUP_X} y="15" font-size="10.5" font-weight="600" fill="var(--muted)" text-anchor="end">
        Gain
      </text>
      <text x={THROUGHPUT_X} y="15" font-size="10.5" font-weight="600" fill="var(--muted)" text-anchor="end">
        MiB/s (old &rarr; now)
      </text>
      <text x={HEAP_X + HEAP_W / 2} y="15" font-size="10.5" font-weight="600" fill="var(--muted)" text-anchor="middle">
        Peak heap
      </text>

      {/* Gridlines & ticks */}
      {
        ticks.map((t) => {
          const x = xFor(t);
          const isBase = Math.abs(t - 1.0) < 1e-6;
          return (
            <g>
              <line
                x1={x.toFixed(1)}
                y1={TOP - 6}
                x2={x.toFixed(1)}
                y2={HEIGHT - BOTTOM + 2}
                stroke={isBase ? 'var(--ctl)' : 'var(--rule)'}
                stroke-width={isBase ? '1.5' : '1'}
                stroke-dasharray={isBase ? undefined : '2 3'}
              />
              <text
                class="ch-mono"
                x={x.toFixed(1)}
                y={TOP - 11}
                font-size="10"
                fill="var(--muted)"
                text-anchor="middle"
              >
                {t.toFixed(1)}x
              </text>
            </g>
          );
        })
      }
      <line x1={PLOT_X} y1={TOP - 6} x2={PLOT_X + PLOT_W} y2={TOP - 6} stroke="var(--rule)" stroke-width="1" />

      {/* Data rows */}
      {
        rows.map((r, idx) => {
          const yTop = TOP + idx * ROW_H;
          const yMid = yTop + ROW_H / 2;
          const xEnd = xFor(r.speedup);
          const hasHeapWin = r.peakRatio !== null && r.peakRatio > 1.02;
          const hasHeapRise = r.peakRatio !== null && r.peakRatio < 0.98;
          const hasHeapMeasured = r.peakRatio !== null;
          return (
            <g>
              {idx % 2 === 1 && (
                <rect
                  x="4"
                  y={yTop + 1}
                  width={WIDTH - 8}
                  height={ROW_H - 2}
                  rx="4"
                  fill="var(--surface)"
                  opacity="0.7"
                />
              )}
              <text
                x={LABEL_X}
                y={yMid + 4}
                font-size="11.5"
                font-weight="600"
                fill="var(--ink)"
                text-anchor="end"
              >
                {r.label}
              </text>

              {/* Range bar + lollipop dot */}
              <rect
                x={PLOT_X}
                y={(yMid - 3.5).toFixed(1)}
                width={Math.max(2, xEnd - PLOT_X).toFixed(1)}
                height="7"
                rx="3.5"
                fill="var(--accent)"
                opacity="0.88"
              />
              <circle cx={xEnd.toFixed(1)} cy={yMid.toFixed(1)} r="4.5" fill="var(--accent-strong)" />

              <text
                class="ch-mono"
                x={SPEEDUP_X}
                y={yMid + 4}
                font-size="11.5"
                font-weight="700"
                fill="var(--accent-strong)"
                text-anchor="end"
              >
                {r.speedup.toFixed(2)}x
              </text>

              <text
                class="ch-mono"
                x={THROUGHPUT_X}
                y={yMid + 4}
                font-size="10.5"
                fill="var(--muted)"
                text-anchor="end"
              >
                {r.v023Mib.toFixed(0)} &rarr; {r.curMib.toFixed(0)}
              </text>

              {hasHeapWin ? (
                <g>
                  <rect
                    x={HEAP_X}
                    y={yMid - 9}
                    width={HEAP_W}
                    height="18"
                    rx="9"
                    fill="var(--green-wash)"
                  />
                  <text
                    class="ch-mono"
                    x={HEAP_X + HEAP_W / 2}
                    y={yMid + 3.5}
                    font-size="10"
                    font-weight="700"
                    fill="var(--green)"
                    text-anchor="middle"
                  >
                    {r.peakRatio!.toFixed(2)}x less heap
                  </text>
                </g>
              ) : hasHeapRise ? (
                <g>
                  <rect
                    x={HEAP_X}
                    y={yMid - 9}
                    width={HEAP_W}
                    height="18"
                    rx="9"
                    fill="var(--ochre-wash)"
                  />
                  <text
                    class="ch-mono"
                    x={HEAP_X + HEAP_W / 2}
                    y={yMid + 3.5}
                    font-size="10"
                    font-weight="700"
                    fill="var(--ochre)"
                    text-anchor="middle"
                  >
                    {(1 / r.peakRatio!).toFixed(2)}x more heap
                  </text>
                </g>
              ) : (
                <text
                  class="ch-mono"
                  x={HEAP_X + HEAP_W / 2}
                  y={yMid + 3.5}
                  font-size="10"
                  fill="var(--muted)"
                  text-anchor="middle"
                >
                  {hasHeapMeasured ? 'steady' : 'n/a'}
                </text>
              )}
            </g>
          );
        })
      }
    </svg>
  </div>
  <table class="sr-only">
    <caption>{title}</caption>
    <thead>
      <tr>
        <th>Workload</th>
        <th>Speedup vs v0.2.3</th>
        <th>v0.2.3 throughput</th>
        <th>Current throughput</th>
        <th>Peak heap vs v0.2.3</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>{r.label}</td>
            <td>{r.speedup.toFixed(2)}x</td>
            <td>{r.v023Mib.toFixed(1)} MiB/s</td>
            <td>{r.curMib.toFixed(1)} MiB/s</td>
            <td>
              {r.peakRatio === null
                ? 'n/a'
                : r.peakRatio > 1.02
                  ? `${r.peakRatio.toFixed(2)}x less heap`
                  : r.peakRatio < 0.98
                    ? `${(1 / r.peakRatio).toFixed(2)}x more heap`
                    : 'steady'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {caption && <figcaption class="chart-cap">{caption}</figcaption>}
</figure>
