---
import { BASE, DOCS_RS_AYAML, GITHUB_URL, NAV_ITEMS, WORKSPACE_VERSION } from '../lib/site';

interface Props {
  as?: 'header' | 'div';
}
const { as: Wrapper = 'header' } = Astro.props;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

function isItemActive(href: string): boolean {
  if (href === `${BASE}/docs/`) {
    return (
      currentPath.startsWith(`${BASE}/docs/`) &&
      !currentPath.startsWith(`${BASE}/docs/correctness/`) &&
      !currentPath.startsWith(`${BASE}/docs/migrating-from/`) &&
      !currentPath.startsWith(`${BASE}/docs/migration/`) &&
      !currentPath.startsWith(`${BASE}/docs/cookbook/`) &&
      !currentPath.startsWith(`${BASE}/docs/security/`)
    );
  }
  if (href.includes('/migrating-from/')) {
    return (
      currentPath.startsWith(`${BASE}/docs/migrating-from/`) ||
      currentPath === `${BASE}/docs/migration/`
    );
  }
  return currentPath === href || currentPath.startsWith(href);
}
---

<Wrapper class="site-header">
  <nav class="site-nav" aria-label="Primary">
    <a class="brand" href={`${BASE}/`} aria-label="ayaml home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>ayaml</span>
    </a>

    <ul class="nav-links" role="list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} aria-current={isItemActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={DOCS_RS_AYAML} target="_blank" rel="noopener noreferrer">
          docs.rs
        </a>
      </li>
    </ul>

    <div class="nav-end">
      <slot name="search" />
      <a
        class="nav-version"
        href={`${GITHUB_URL}/blob/main/CHANGELOG.md`}
        target="_blank"
        rel="noopener noreferrer"
        title={`ayaml ${WORKSPACE_VERSION} changelog`}
      >
        v{WORKSPACE_VERSION}
      </a>
      <a
        class="nav-icon"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ayaml on GitHub"
        title="ayaml on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <slot name="end" />
    </div>
  </nav>
</Wrapper>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--nav-h);
    padding-inline: var(--gutter);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    color: var(--ink);
    font-size: 1.28rem;
    font-weight: 760;
    letter-spacing: -0.035em;
    text-decoration: none;
  }
  .brand-mark {
    width: 3.5px;
    height: 20px;
    border-radius: 2px;
    background: var(--accent);
  }
  .nav-links {
    display: flex;
    align-items: stretch;
    gap: 15px;
    height: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-links li {
    display: flex;
    flex-shrink: 0;
    margin: 0;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-links a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .nav-end {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .nav-version {
    padding: 4px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.76rem;
    text-decoration: none;
  }
  .nav-version:hover {
    border-color: var(--ctl);
    color: var(--ink);
  }
  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
  }
  .nav-icon:hover {
    background: var(--wash);
    color: var(--ink);
  }
  @media (max-width: 1180px) {
    .nav-version {
      display: none;
    }
    .site-nav {
      gap: 12px;
    }
    .nav-links {
      gap: 13px;
    }
  }
  @media (max-width: 960px) {
    .site-nav {
      gap: 10px;
    }
    .nav-links {
      gap: 11px;
      font-size: 0.86rem;
    }
  }
  @media (max-width: 820px) {
    .nav-links {
      padding-inline-end: 16px;
      mask-image: linear-gradient(to right, #000 88%, transparent);
      -webkit-mask-image: linear-gradient(to right, #000 88%, transparent);
    }
  }
</style>
